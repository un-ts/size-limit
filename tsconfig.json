{
  "extends": "@1stg/tsconfig/lib",
  "compilerOptions": {
    "noEmit": true,
    // https://github.com/microsoft/TypeScript/wiki/Node-Target-Mapping#node-12
    "target": "ES2019",
    "types": ["node", "web", "mdx", "vite/client"],
    "paths": {
      "size-limit-node-esbuild": ["./packages/node-esbuild/src/index.ts"],
      "size-limit-preset-node-lib": ["./packages/preset-node-lib/src/index.ts"]
    }
  }
}
