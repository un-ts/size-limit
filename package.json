{
  "name": "@unts/size-limit",
  "version": "0.0.0",
  "type": "module",
  "description": "Incredible `size-limit` plugins, make `size-limit` greater",
  "repository": "git+https://github.com/un-ts/size-limit.git",
  "author": "JounQin <admin@1stg.me> (https://www.1stG.me)",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf -g 'packages/**/{lib,*.tsbuildinfo}'",
    "dev": "yarn docs",
    "docs": "vite",
    "docs:build": "vite build",
    "format": "prettier --write .",
    "lint": "run-p 'lint:*'",
    "lint:es": "eslint . --cache",
    "lint:style": "stylelint . --cache",
    "lint:tsc": "tsc --noEmit",
    "prepare": "simple-git-hooks && yarn-berry-deduplicate || exit 0",
    "release": "yarn build && changeset publish",
    "serve": "sirv dist -s",
    "test": "size-limit",
    "test:unit": "vitest run",
    "typecov": "type-coverage",
    "version": "changeset version && yarn --no-immutable"
  },
  "devDependencies": {
    "@1stg/app-config": "^15.0.0",
    "@1stg/common-config": "^15.0.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@mdx-js/rollup": "^3.1.1",
    "@shikijs/rehype": "^4.5.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web": "^0.0.358",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^10.12.0",
    "github-markdown-css": "^5.9.0",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "rimraf": "^6.1.3",
    "sass": "^1.105.1",
    "simple-git-hooks": "^2.14.0",
    "sirv-cli": "^3.0.1",
    "size-limit": "^14.1.0",
    "size-limit-node-esbuild": "link:packages/node-esbuild",
    "size-limit-preset-node-lib": "link:packages/preset-node-lib",
    "stylelint": "^17.16.0",
    "type-coverage": "^2.30.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3",
    "yarn-berry-deduplicate": "^7.0.1"
  },
  "browserslist": "extends @1stg/browserslist-config/modern",
  "commitlint": {
    "extends": "@1stg"
  },
  "markuplint": {
    "extends": "@1stg/markuplint-config"
  },
  "prettier": "@1stg/prettier-config",
  "remarkConfig": {
    "plugins": [
      "@1stg/preset"
    ]
  },
  "size-limit": [
    {
      "path": "./packages/node-esbuild/src/index.ts",
      "limit": "900B",
      "ignore": [
        "@size-limit/esbuild",
        "esbuild",
        "size-limit"
      ]
    },
    {
      "path": "./packages/preset-node-lib/src/index.ts",
      "limit": "400B",
      "ignore": [
        "@size-limit/file",
        "size-limit-node-esbuild"
      ]
    }
  ],
  "stylelint": {
    "extends": "@1stg/stylelint-config"
  },
  "typeCoverage": {
    "atLeast": 100,
    "cache": true,
    "detail": true,
    "ignoreAsAssertion": true,
    "ignoreNonNullAssertion": true,
    "showRelativePath": true,
    "strict": true,
    "update": true
  }
}
